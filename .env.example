# === Required ===

# MySQL connection string (MySQL 8+ or TiDB). Include ?ssl={"rejectUnauthorized":true}
# or the provider's SSL params if the host requires TLS (TiDB Cloud does).
DATABASE_URL=mysql://user:password@host:3306/sales_dashboard

# Secret used to sign admin session cookies. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# Password that unlocks the Upload/admin area of the dashboard
ADMIN_PASSWORD=

# === Optional ===

# Name shown in the sidebar when signed in (default: Admin)
# ADMIN_NAME=

# Port the server listens on (default: 3000; most hosts set this for you)
# PORT=3000

# S3-compatible storage for keeping copies of uploaded Excel files.
# Leave unset to skip file storage — imports work fine without it.
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=        # e.g. https://<account>.r2.cloudflarestorage.com for Cloudflare R2
# S3_REGION=auto
